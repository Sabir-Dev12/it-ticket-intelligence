          "type": "string",
          "maxLength": 200
        },
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "query"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": [
                  "string",
                  "integer"
                ],
                "pattern": "^-?(?:0|[1-9]\\d*)$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "Open",
                  "InProgress",
                  "Resolved",
                  "Closed"
                ]
              },
              "isArchived": {
                "type": "boolean"
              },
              "assignedTeamId": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              }
            },
            "required": [
              "id",
              "revision",
              "title",
              "description",
              "status",
              "isArchived",
              "assignedTeamId"
            ]
          }
        },
        "page": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "pageSize": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^-?(?:0|[1-9]\\d*)$"
        },
        "hasMore": {
          "type": "boolean"
        }
      },
      "required": [
        "items",
        "page",
        "pageSize",
        "hasMore"
      ]
