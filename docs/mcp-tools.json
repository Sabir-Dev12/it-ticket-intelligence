[
  {
    "name": "get_ticket",
    "description": "Read one ticket in the caller's authorized scope. Reported symptoms are not verified diagnoses.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ticketId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "ticketId"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "revision": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^-?(?:0|[1-9]\\d*)$"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "status": {
              "enum": [
                "Open",
                "InProgress",
                "Resolved",
                "Closed"
              ]
            },
            "isArchived": {
              "type": "boolean"
            },
            "assignedTeamId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          },
          "required": [
            "id",
            "revision",
            "title",
            "description",
            "status",
            "isArchived",
            "assignedTeamId"
          ]
        }
      },
      "required": [
        "ticket"
      ]
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "_meta": {
      "requiredPermission": "tickets.read"
    }
  },
  {
    "name": "search_tickets",
