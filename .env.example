# Copy to .env and set a local secret, or use scripts/Initialize-Postgres.ps1.
# .env is ignored. Do not commit credentials.
Database__Password=

# LLM settings are read only from environment variables. No request runs at startup.
LLM__Provider=Ollama
LLM__BaseUrl=http://127.0.0.1:11434/
LLM__Model=qwen3:1.7b
# Required for OpenAICompatible; set the real value only in your environment or ignored .env.
LLM__ApiKey=
LLM__AttemptTimeoutSeconds=30
LLM__TotalTimeoutSeconds=90
LLM__MaxRetries=2
LLM__RetryDelayMilliseconds=200
LLM__MaxOutputTokens=1024
LLM__ContextWindowTokens=16384
LLM__TokenLimitParameter=max_completion_tokens

# Existing RAG adapter: pinned local embedding model. Reindex if this profile changes.
Rag__Ollama__BaseUrl=http://localhost:11434/
Rag__Ollama__Model=nomic-embed-text:latest
Rag__Ollama__ModelDigest=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f
Rag__Ollama__Dimensions=768

# MCP is closed without configured clients. Never put the bearer token in Git.
# Store only the SHA-256 lowercase hex digest in this process environment / ignored .env.
# MCP__Clients__0__TokenHash=
# MCP__Clients__0__Subject=local-mcp-client
# MCP__Clients__0__Permissions=tickets.read,tickets.search,tickets.history.read,knowledge.read,teams.read,system.status.read
# MCP__Clients__0__TicketIds=one-or-more-authorized-ticket-guids-separated-by-commas
# MCP__Clients__0__AllTickets=false
MCP__AllowedHosts=localhost,127.0.0.1,::1
# Browser origins are denied by default; only list exact trusted origins if needed.
MCP__AllowedOrigins=

# SignalR reuses the MCP client profiles, requiring tickets.read and the ticket scope.
# Private AI Assistant conversations also require this optional profile-to-user mapping.
# Set an existing active user UUID; never accept the owner from a request body.
# MCP__Clients__0__UserId=<active-user-uuid>
# Exact browser origins, comma-separated. Empty denies browser Origin headers.
# Realtime__AllowedOrigins=http://127.0.0.1:5173,http://localhost:5173

# User JWT authentication. Generate a random key with scripts/Initialize-Jwt.ps1.
# JWT__SigningKey=
# Bootstrap only before the first credential exists, after migrations. No default password.
# AUTH__BootstrapEmail=
# AUTH__BootstrapPassword=
